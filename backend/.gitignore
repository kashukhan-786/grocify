@"
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log

# Coverage
coverage/
*.lcov

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# IDE files
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db
"@ | Set-Content -Path .gitignore -Encoding UTF8